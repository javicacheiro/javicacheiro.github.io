import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'what-i-do', text: 'What I Do' },
  { depth: 2, slug: 'onehealth-dataspace', text: 'OneHealth DataSpace' },
  { depth: 2, slug: 'topics', text: 'Topics I Write About' },
  { depth: 2, slug: 'find-me', text: 'Find Me' },
  { depth: 2, slug: 'about-site', text: 'About This Site' }
